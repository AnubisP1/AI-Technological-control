{
	# Cloudflare Tunnel уже терминирует HTTPS на границе — Caddy слушает
	# обычный HTTP локально (localhost:8787), не пытается сам получать
	# TLS-сертификат (внешнего трафика на порт 80/443 этого Mac нет).
	auto_https off
}

:8787 {
	# API — проксируем на backend (uvicorn), сохраняя префикс /api
	# отрезанным, как раньше делал Vite dev-proxy (rewrite path.replace(/^\/api/, '')).
	handle_path /api/* {
		reverse_proxy localhost:8000
	}

	# Всё остальное — статика продакшен-сборки фронтенда с fallback на
	# index.html для клиентского роутинга (React Router).
	handle {
		root * "/Users/bdd/Documents/Работа/Аэромобильность/4. Цифровое производство/dev/frontend-v2/dist"
		try_files {path} /index.html
		file_server
	}
}
