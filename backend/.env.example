CPU_BUDGET_FRACTION=0.4
LOG_LEVEL=INFO

# Реальная тесселяция STEP -> STL для точного 3D-просмотра (Фаза 17,
# часть 5) — требует pythonocc-core, который распространяется только
# через conda-forge (не публикуется на PyPI), поэтому ставится отдельным
# conda-окружением, не в основной venv. Установка (один раз):
#   1. Установить Miniforge: https://github.com/conda-forge/miniforge
#   2. conda create -n pythonocc python=3.11 pythonocc-core -c conda-forge
#   3. Указать путь к python внутри этого окружения ниже.
# Если не задано — PartViewer использует параметрический прокси-бокс
# по габаритам bounding box (не ошибка, а документированный fallback).
# PYTHONOCC_PYTHON_PATH=/путь/к/miniforge3/envs/pythonocc/bin/python

# Локальный LLM — Qwen2.5-7B-Instruct (GGUF, Q4_K_M), через
# llama-cpp-python, полностью офлайн после установки (Фаза 18, заменяет
# прежний облачный YandexGPT, см. dev/QUESTIONS.md №14). Используется для
# аналитики технологичности в отчёте КД (Модуль 1.2) и AI-ассистента по
# НСИ (экран "Обзор") — без него оба работают на шаблонном тексте.
# Установка (один раз, ~4.5GB):
#   pip install huggingface_hub[cli]
#   hf download bartowski/Qwen2.5-7B-Instruct-GGUF Qwen2.5-7B-Instruct-Q4_K_M.gguf \
#     --local-dir ../models/qwen
# LLAMA_MODEL_PATH=../models/qwen/Qwen2.5-7B-Instruct-Q4_K_M.gguf
# LLAMA_CONTEXT_SIZE=4096

# Облачный LLM — Polza.ai (Фаза 18, часть 2, см. dev/QUESTIONS.md №15),
# OpenAI-совместимый API, та же модель qwen/qwen-2.5-7b-instruct, что и
# локальный контур выше. ⚠️ Осознанное повторное исключение из
# офлайн-требования ТЗ по прямому решению пользователя — работает
# ПАРАЛЛЕЛЬНО локальному Qwen (приоритетнее, если задан ключ), не
# заменяет его. Ключ — только в .env, никогда не в коде/гите.
# POLZA_API_KEY=
